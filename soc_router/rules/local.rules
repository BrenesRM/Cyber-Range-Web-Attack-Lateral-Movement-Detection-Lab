# ==============================================================================
# CYBER RANGE CUSTOM IDS RULES (Suricata / Snort Compatible)
# Scenario: Web Exploitation & Lateral Movement Detection
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RECONNAISSANCE & SCANNING
# ------------------------------------------------------------------------------
alert tcp 10.10.10.0/24 any -> 10.10.20.50 any (msg:"[SOC-ALERT] [T1595] External Port Scan Detected against DMZ Web Target"; flags:S; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1595.002] Automated Vulnerability Scanner User-Agent Detected"; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000002; rev:1;)
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1595.002] Nikto Scanner Probing Web Target"; http.user_agent; content:"Nikto"; nocase; classtype:web-application-attack; sid:1000003; rev:1;)

# ------------------------------------------------------------------------------
# 2. WEB EXPLOITATION: SQL INJECTION (SQLi)
# ------------------------------------------------------------------------------
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1190] Web Application SQLi Attempt - UNION SELECT Pattern"; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; classtype:web-application-attack; sid:1000010; rev:1;)
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1190] Web Application SQLi Attempt - Boolean Tautology (OR 1=1)"; http.uri; content:"or"; nocase; classtype:web-application-attack; sid:1000011; rev:1;)

# ------------------------------------------------------------------------------
# 3. WEB EXPLOITATION: PATH TRAVERSAL / LFI
# ------------------------------------------------------------------------------
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1083] Directory Traversal / LFI Attempt against /etc/passwd"; http.uri; content:"etc/passwd"; nocase; classtype:web-application-attack; sid:1000020; rev:1;)
alert http 10.10.10.0/24 any -> 10.10.20.50 $HTTP_PORTS (msg:"[SOC-ALERT] [T1083] Directory Traversal Dot-Dot-Slash Sequence Detected"; http.uri; content:".."; classtype:web-application-attack; sid:1000021; rev:1;)

# ------------------------------------------------------------------------------
# 4. LATERAL MOVEMENT: DMZ TO INTERNAL NETWORK PIVOTING
# ------------------------------------------------------------------------------
alert ip 10.10.20.0/24 any -> 10.10.30.0/24 any (msg:"[SOC-ALERT] [T1021] Suspicious Lateral Movement: DMZ Host Connecting to Internal Corporate Segment"; classtype:bad-unknown; sid:1000030; rev:1;)
alert tcp 10.10.20.0/24 any -> 10.10.30.50 5000 (msg:"[SOC-ALERT] [T1570] Lateral Movement: DMZ Node Querying Internal Financial/Customer API"; flow:to_server,established; classtype:suspicious-filename-detect; sid:1000031; rev:1;)
alert tcp 10.10.20.0/24 any -> 10.10.30.50 22 (msg:"[SOC-ALERT] [T1021.004] Lateral Movement: DMZ Node Initiating SSH Session to Internal Database"; flow:to_server; classtype:suspicious-login; sid:1000032; rev:1;)

# ------------------------------------------------------------------------------
# 5. PERIMETER VIOLATION: DIRECT ATTACKER TO INTERNAL ATTEMPT
# ------------------------------------------------------------------------------
alert ip 10.10.10.0/24 any -> 10.10.30.0/24 any (msg:"[SOC-ALERT] [T1046] Direct Perimeter Breach Attempt: External Attacker Probing Internal Segment"; classtype:attempted-admin; sid:1000040; rev:1;)
